{
  "name": "gymapp",
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "test": "pnpm test:unit && pnpm test:api && pnpm --filter frontend test",
    "test:unit": "pnpm --filter backend test:unit",
    "test:api": "pnpm --filter backend test:api",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:setup": "pnpm test:db:create && pnpm test:db:prepare",
    "test:run": "powershell -ExecutionPolicy Bypass -File scripts/run-tests.ps1",
    "test:db:create": "powershell -ExecutionPolicy Bypass -File scripts/create-test-db.ps1",
    "test:db:prepare": "node --env-file=.env.test scripts/prepare-test-db.mjs",
    "test:cov": "pnpm --filter backend test:cov",
    "backend:dev": "pnpm --filter backend dev",
    "frontend:dev": "pnpm --filter frontend dev",
    "prisma:generate": "pnpm exec prisma generate --schema backend/prisma/schema.prisma",
    "prisma:migrate": "pnpm exec prisma migrate dev --schema backend/prisma/schema.prisma",
    "prisma:seed": "pnpm exec prisma db seed --schema backend/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.5+sha512.cdf928fca20832cd59ec53826492b7dc25dc524d4370b6b4adbf65803d32efaa6c1c88147c0ae4e8d579a6c9eec715757b50d4fa35eea179d868eada4ed043af"
}
