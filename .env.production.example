# Copy to .env.production and fill in values before docker compose up
# cp .env.production.example .env.production

# --- HTTP ---
# Port exposed on the EC2 host (80 for production, 8080 if 80 is taken locally)
HTTP_PORT=80

# Public URL users open in the browser (used for CORS)
CORS_ORIGIN=http://your-ec2-public-ip

# --- MySQL (db container) ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=gymapp
MYSQL_USER=gymapp
MYSQL_PASSWORD=change-me-db-password

# --- JWT (use long random strings, 32+ chars) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-production
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- First deploy only: seed demo accounts (owner/manager/trainer) ---
# Set to true once, then set back to false and redeploy
SEED_ON_START=true

# DATABASE_URL is constructed automatically in docker-compose.yml:
# mysql://gymapp:PASSWORD@db:3306/gymapp
