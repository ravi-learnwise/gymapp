# Copy to .env and adjust as needed
# cp .env.example .env   (or: copy .env.example .env on Windows)

# Database (portable MySQL on G: drive)
DATABASE_URL="mysql://gymapp:gymapp_dev@localhost:3306/gymapp"
# Root URL for Prisma migrate shadow DB (local dev only — root has no password)
SHADOW_DATABASE_URL="mysql://root@localhost:3306/gymapp"

# Backend
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# JWT (Phase 1 — placeholder values for local dev)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend (Vite — optional override)
VITE_API_URL=http://localhost:3000/api
